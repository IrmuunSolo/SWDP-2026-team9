    "@nestjs/platform-express": "11.2.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "jose": "6.2.13",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^7.0.3",
