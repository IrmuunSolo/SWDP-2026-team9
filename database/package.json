{
  "name": "@campusfind/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js studio",
    "db:validate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js validate",
    "db:seed": "node --env-file-if-exists=../.env --import tsx src/seed.ts"
  },
  "dependencies": {
    "@campusfind/contracts": "0.1.0",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.6"
  }
}
